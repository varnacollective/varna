{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "next-env.d.ts",
    "src/agents/**/*",
    "src/lib/list-uploads/**/*",
    "src/lib/invitations/**/*",
    "src/components/ListUpload/**/*",
    "src/app/api/superadmin/list-uploads/**/*",
    "src/app/superadmin/partners/invitations/upload/**/*",
    "tests/agents/**/*",
    "tests/list-uploads/**/*",
    "scripts/list-agent/**/*",
    "src/lib/auth/**/*",
    "src/app/api/superadmin/logins/**/*",
    "src/app/superadmin/credentials/**/*",
    "tests/auth/**/*",
    "vitest.config.mts"
  ]
}
