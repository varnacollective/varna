# ─── Supabase Configuration ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google Gemini AI Configuration ────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GOOGLE_GEMINI_MODEL=gemini-3.8-flash

# ─── Google Service Account & Sheets Ingestion ─────────────
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-primary-sheet-id
GOOGLE_SHEET_ID_CONFIDENCE=your-confidence-sheet-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ─── Partner Invitation & Email (SMTP) ──────────────────────
INVITATION_FROM_EMAIL=invitations@varnacollective.com
INVITATION_FROM_NAME="Varna Collective"
INVITATION_REPLY_TO=yuvraj@varnacollective.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NEXT_PUBLIC_SITE_URL=https://dashboard.varnacollective.com
VARNA_HELP_EMAIL=yuvraj@varnacollective.com
